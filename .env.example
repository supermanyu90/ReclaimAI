# Copy to .env. Never commit .env. Cloud secrets belong in Secret Manager, not here.

# local: deterministic fixtures, visibly synthetic. cloud: real adapters or explicit "unavailable".
APP_MODE=local

API_PORT=8100
WORKER_PORT=8101
WEB_PORT=3100
DB_PORT=55432
DATABASE_URL=postgresql+psycopg://reclaim:reclaim@localhost:55432/reclaim
WEB_ORIGIN=http://localhost:3100
API_URL=http://localhost:8100
LOG_LEVEL=INFO
LOCAL_STORAGE_DIR=.data/objects

# --- Chat model. Empty = ollama in local mode (real local inference, labelled "not Gemini"),
# gemini in cloud mode. "fixture" = deterministic regex rules for tests/CI, not a model.
LLM_PROVIDER=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_S=30

# --- Per-service providers. Empty = the mode's default (local | cloud | demo; see config.PROVIDER_DEFAULTS).
DOCUMENTS_PROVIDER=
RETRIEVAL_PROVIDER=
EVENTS_PROVIDER=
WAREHOUSE_PROVIDER=
STORAGE_PROVIDER=

# --- Google Cloud (APP_MODE=cloud). Verify regional availability per service.
GCP_PROJECT=
VERTEX_LOCATION=
GEMINI_MODEL=
DOCAI_LOCATION=
DOCAI_PROCESSOR_ID=
SEARCH_LOCATION=
SEARCH_DATASTORE_ID=
CLASSIFIER_ENDPOINT_ID=
DOCAI_EXTRACTOR_ID=
PUBSUB_TOPIC=
ANALYTICS_TOPIC=
TRANSACTIONS_TOPIC=
GCS_BUCKET=
BIGQUERY_DATASET=
BIGQUERY_LOCATION=
# Worker (cloud): its own URL as OIDC audience, and the one identity allowed per endpoint.
WORKER_AUDIENCE=
PUSH_SERVICE_ACCOUNT=
SCHEDULER_SERVICE_ACCOUNT=
# Terraform sets all of the above on Cloud Run (infra/terraform, docs/DEPLOYMENT.md).

# --- Telegram. In cloud these come from Secret Manager. Without a webhook secret the
# webhook refuses every request. dry_run records replies; "live" sends via the Bot API.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SEND_MODE=dry_run
# Keyed hash for stored chat IDs. Required outside local mode.
CHANNEL_HASH_KEY=

# --- Optional dormant-asset recovery (synthetic registry only). false hides it entirely.
RECOVERY_ENABLED=true
